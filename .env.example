# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir
# cp .env.example .env

# Veritabanı (başlangıç için SQLite; büyüyünce PostgreSQL'e geçebilirsin)
DATABASE_URL=sqlite:///./roman.db
# PostgreSQL örneği:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/roman_db

# Sadece docker-compose kullanıyorsan gerekli - Postgres container şifresi
# (docker-compose.yml bunu otomatik okur, DATABASE_URL'i kendisi oluşturur)
POSTGRES_PASSWORD=

# DashScope (Qwen) API anahtarı - https://dashscope.aliyuncs.com konsolundan alınır
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Veritabanı şifreleme anahtarı - ZORUNLU, uygulama bu olmadan başlamaz.
# Karakter/mekan/olay bilgileri ve roman metni bu anahtarla şifrelenir;
# veritabanı dosyası tek başına çalınsa bile bu anahtar olmadan okunamaz.
# Üretmek için (bir kere üret, sonra hep aynısını kullan - değiştirirsen
# eski veriler okunamaz hale gelir):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bu anahtarı .env dışında ayrıca güvenli bir yerde de sakla (parola yöneticisi
# gibi) - .env dosyası kaybolursa/silinirse tüm roman verisi kurtarılamaz olur.
DB_ENCRYPTION_KEY=

# JWT için gizli anahtar - rastgele uzun bir metin gir (örn: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# İlk kullanıcı (uygulama ilk açılışta yoksa otomatik oluşturulur)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
